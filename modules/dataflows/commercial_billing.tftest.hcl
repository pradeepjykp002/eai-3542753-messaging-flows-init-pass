run "commercial_billing_topic_name" {
  command = plan

  assert {
    condition     = module.commercial_topics.topic_names["topic_commercial_billing_autocoder-autocode_xml"] == "dev.commercial.billing.autocoder-autocode.xml"
    error_message = "commercial billing topic name must follow dev.commercial.billing.<data_domain>.xml"
  }
}

run "commercial_billing_statement_contains_expected_insert" {
  command = plan

  assert {
    condition     = can(regex("INSERT INTO `dev\\.commercial\\.billing\\.autocoder-autocode\\.xml`", module.flink_statement_set_commercial_billing_from_topic_commercial_billing_autocoder_xml.statement))
    error_message = "commercial billing autocoder statement must insert into the autocoder-autocode topic"
  }
}
