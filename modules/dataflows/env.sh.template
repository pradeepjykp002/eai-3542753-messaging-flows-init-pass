#!/usr/bin/env bash
# Source this file before running tofu commands directly against the dataflows
# module (e.g. during testing). In normal use, variables flow in from the root
# environment module via module "dataflows" in environments/dev/main.tf.
#
#   source modules/dataflows/env.sh
#   tofu -chdir=modules/dataflows test

# Flink env vars must be unset -- when set the Confluent provider routes all
# Flink statements to one pool as one principal, overriding per-statement config.
unset FLINK_API_KEY FLINK_API_SECRET FLINK_REST_ENDPOINT

# Confluent Cloud control-plane API key. Read directly from the OS environment.
export CONFLUENT_CLOUD_API_KEY=""
export CONFLUENT_CLOUD_API_SECRET=""

export TF_VAR_env=""

# Confluent identifiers and endpoints.
# organization_id:               Confluent Cloud -> Administration -> Billing & payment
# environment_id:                Confluent Cloud -> <environment> -> Settings
# kafka_cluster_id:              Confluent Cloud -> <environment> -> <cluster> -> Cluster settings
# schema_registry_id:            Confluent Cloud -> <environment> -> Schema Registry -> Cluster settings
# principal_id:                  the service account or user ID that runs tofu apply
export TF_VAR_confluent_cluster='{
  "organization_id":               "",
  "environment_id":                "",
  "kafka_cluster_id":              "",
  "kafka_rest_endpoint":           "",
  "schema_registry_id":            "",
  "schema_registry_rest_endpoint": "",
  "flink_rest_endpoint":           "",
  "principal_id":                  ""
}'

# Kafka data-plane credentials.
export TF_VAR_kafka_credentials='{"key": "", "secret": ""}'

# Schema Registry credentials.
export TF_VAR_schema_registry_credentials='{"key": "", "secret": ""}'

# Flink credentials scoped to the environment and region.
export TF_VAR_flink_credentials='{"key": "", "secret": ""}'

# IDs sourced from the account-setup module in normal use; set manually for
# standalone testing.
export TF_VAR_admin_compute_pool_id=""
# TF_VAR_flink_compute_pool_ids, TF_VAR_flink_service_account_ids, and
# TF_VAR_eai_identity_pool_ids are JSON maps -- set them via a tfvars file
# for standalone testing rather than as environment variables.
