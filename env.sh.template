#!/usr/bin/env bash
# Copy to env.sh (gitignored), fill in the secrets, then:
#   source env.sh
#   make bootstrap-phase1-dev

# Flink env vars must be unset -- when set the Confluent provider routes all
# Flink statements to one pool as one principal, overriding per-statement config.
unset FLINK_API_KEY FLINK_API_SECRET FLINK_REST_ENDPOINT

# Confluent Cloud control-plane API key (Administration -> Cloud API keys).
# Read directly from the OS environment by the provider -- not a TF_VAR_.
export CONFLUENT_CLOUD_API_KEY=""
export CONFLUENT_CLOUD_API_SECRET=""

# Passphrase for OpenTofu state/plan encryption (at least 16 characters).
# Keep in the password manager: state cannot be read without it.
export TF_VAR_state_encryption_passphrase=""

# Okta OIDC issuer URL for the environment's identity provider.
# Custom authorization server: https://your-org.okta.com/oauth2/ausXXX
export TF_VAR_okta_issuer=""

# Confluent principal ID of the runner, granted Assigner on Flink service accounts.
# Confluent Cloud -> Administration -> Accounts & access -> Service accounts
export TF_VAR_principal_id=""

# Kafka data-plane credentials scoped to the environment's Kafka cluster.
# Needed from phase 4 (dataflows apply) onwards.
export TF_VAR_kafka_api_key=""
export TF_VAR_kafka_api_secret=""

# Schema Registry credentials. Needed from phase 4 onwards.
export TF_VAR_schema_registry_api_key=""
export TF_VAR_schema_registry_api_secret=""

# Flink API key scoped to the environment and cluster region.
# Needed from phase 4 onwards.
export TF_VAR_flink_api_key=""
export TF_VAR_flink_api_secret=""
